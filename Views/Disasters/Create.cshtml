@model GiftGivers.Models.Disaster

@{
    ViewData["Title"] = "Report Disaster";
}

<div class="container">
    <h1 class="display-5">@ViewData["Title"]</h1>
    <p class="lead-subtitle">Provide details about the incident to help us coordinate a response.</p>

    <div class="form-container">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Disaster Name -->
            <div class="form-group">
                <label asp-for="DisasterName" class="form-label"></label>
                <input asp-for="DisasterName" class="form-control" placeholder="e.g., KZN Floods" />
                <span asp-validation-for="DisasterName" class="text-danger"></span>
            </div>

            <!-- Location -->
            <div class="form-group">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="e.g., Durban, KZN" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <!-- Start Date -->
            <div class="form-group">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe the situation..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- Submit & Cancel Buttons -->
            <div class="d-grid gap-2 mt-4">
                <input type="submit" value="Submit Report" class="btn btn-primary" />
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>


@model IEnumerable<GiftGivers.Models.Disaster>

@{
    ViewData["Title"] = "Active Disasters";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="display-5">@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i>Report New
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="list-container">
            @foreach (var item in Model)
            {
                <!-- iOS-style List Item Card -->
                <a class.list-card" asp-action="Details" asp-route-id="@item.DisasterId">
                    <div class="list-card-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div class="list-card-content">
                        <span class="list-card-title">@item.DisasterName</span>
                        <span class="list-card-subtitle">@item.Location</span>
                    </div>
                    <div class="list-card-chevron">
                        <i class="fa-solid fa-chevron-right"></i>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title">No Disasters Reported</h5>
                <p class="card-text text-muted">There are currently no active disaster reports.</p>
                <a asp-action="Create" class="btn btn-primary">Be the first to report one</a>
            </div>
        </div>
    }
</div>

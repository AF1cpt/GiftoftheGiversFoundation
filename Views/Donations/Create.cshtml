@model GiftGivers.Models.Donation

@{
    ViewData["Title"] = "Make a Donation";
}

<div class="container">
    <h1 class="display-5">@ViewData["Title"]</h1>
    <p class="lead-subtitle">Your contribution matters.</p>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="DisasterId" class="form-label">For Which Disaster?</label>
                    <select asp-for="DisasterId" class="form-select" asp-items="ViewBag.DisasterId">
                        <option value="">-- Select a Disaster --</option>
                    </select>
                    <span asp-validation-for="DisasterId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ItemType" class="form-label">Item(s)</label>
                    <input asp-for="ItemType" class="form-control" placeholder="e.g., Canned Food, Blankets" />
                    <span asp-validation-for="ItemType" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <input type="submit" value="Submit Donation" class="btn btn-primary btn-lg" />
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

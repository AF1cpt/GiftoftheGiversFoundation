@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>How would you like to help today?</p>
</div>

<div class="container mt-4">
    <div class="row">
        <!-- CARD 1: Report a Disaster -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Report a Disaster</h5>
                    <p class="card-text">Let us know about an emergency.</p>
                    <a asp-controller="Disaster" asp-action="Create" class="stretched-link mt-auto"></a>
                </div>
            </div>
        </div>

        <!-- CARD 2: Make a Donation -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Make a Donation</h5>
                    <p class="card-text">Donate items and supplies.</p>
                    <a asp-controller="Donations" asp-action="Create" class="stretched-link mt-auto"></a>
                </div>
            </div>
        </div>

        <!-- CARD 3: View Active Disasters -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">View Active Disasters</h5>
                    <p class="card-text">See all reported incidents.</p>
                    <a asp-controller="Disaster" asp-action="Index" class="stretched-link mt-auto"></a>
                </div>
            </div>
        </div>

        <!-- CARD 4: Sign up to Volunteer -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Sign up to Volunteer</h5>
                    <p class="card-text">Find and sign up for tasks.</p>
                    <a asp-controller="Volunteer" asp-action="Index" class="stretched-link mt-auto"></a>
                </div>
            </div>
        </div>
    </div>
</div>

